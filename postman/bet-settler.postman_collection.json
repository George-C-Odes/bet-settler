  "item": [
    {
      "name": "REST API",
      "description": "Application API endpoints documented in the README and controller mappings.",
      "item": [
        {
          "name": "Publish event outcome",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventName\": \"{{eventName}}\",\n  \"eventWinnerId\": \"{{eventWinnerId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/event-outcomes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "event-outcomes"
              ]
            },
            "description": "Publishes a sports event outcome for asynchronous processing. The service waits briefly for Kafka acknowledgement before returning 202 Accepted."
          },
          "response": []
        },
        {
          "name": "Get all bets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bets"
              ]
            },
            "description": "Returns the Flyway-seeded bet data."
          },
          "response": []
        },
        {
          "name": "Get bets by eventId",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bets?eventId={{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bets"
              ],
              "query": [
                {
                  "key": "eventId",
                  "value": "{{eventId}}"
                }
              ]
            },
            "description": "Returns only bets linked to the supplied event identifier."
          },
          "response": []
        },
        {
          "name": "Get bets for event with no seeded matches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bets?eventId={{eventWithoutBetsId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bets"
              ],
              "query": [
                {
                  "key": "eventId",
                  "value": "{{eventWithoutBetsId}}"
                }
              ]
            },
            "description": "Useful for exercising the no-match path documented in the README using EVT-9999."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Demo helpers",
      "description": "These endpoints are only available when the application runs with the local-docker, local-fallback, or test profile.",
      "item": [
        {
          "name": "Reset demo state",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/internal/demo/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "internal",
                "demo",
                "reset"
              ]
            },
            "description": "Clears transient processing state while preserving the seeded bets. Returns 404 when demo profiles are inactive."
          },
          "response": []
        },
        {
          "name": "Retry settlements",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/internal/demo/retry-settlements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "internal",
                "demo",
                "retry-settlements"
              ]
            },
            "description": "Replays settlement audit rows that remain PENDING or FAILED through the currently configured settlement transport."
          },
          "response": []
        }
      ]
    },
