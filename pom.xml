<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.github.georgecodes</groupId>
    <artifactId>bet-settler</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>bet-settler</name>
    <description>bet-settler</description>
    <url>https://github.com/George-C-Odes/bet-settler</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>george-c-odes</id>
            <name>George C</name>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/George-C-Odes/bet-settler.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/George-C-Odes/bet-settler.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/George-C-Odes/bet-settler</url>
    </scm>
    <properties>
        <java.version>25</java.version>
        <javassist.version>3.31.0-GA</javassist.version>
        <rocketmq.spring.version>2.3.5</rocketmq.spring.version>
        <springdoc.openapi.version>3.0.3</springdoc.openapi.version>
        <google.java.format.version>1.35.0</google.java.format.version>
        <lombok.version>1.18.46</lombok.version>
        <spotless.maven.version>3.4.0</spotless.maven.version>
        <maven.pmd.plugin.version>3.28.0</maven.pmd.plugin.version>
        <pmd.version>7.24.0</pmd.version>
        <spotbugs.maven.plugin.version>4.9.8.3</spotbugs.maven.plugin.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <jacoco.maven.plugin.version>0.8.14</jacoco.maven.plugin.version>
        <jacoco.output.directory>${project.build.directory}${file.separator}jacoco-report</jacoco.output.directory>
        <jacoco.data.file>${jacoco.output.directory}${file.separator}jacoco.exec</jacoco.data.file>
        <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
        <coverage.line.minimum>0.96</coverage.line.minimum>
        <coverage.branch.minimum>0.91</coverage.branch.minimum>
        <coverage.domain.application.line.minimum>0.96</coverage.domain.application.line.minimum>
        <coverage.domain.application.branch.minimum>0.91</coverage.domain.application.branch.minimum>
        <coverage.infrastructure.line.minimum>0.95</coverage.infrastructure.line.minimum>
        <coverage.infrastructure.branch.minimum>0.90</coverage.infrastructure.branch.minimum>
        <compact.constructor.javadoc.param.check.skip>false</compact.constructor.javadoc.param.check.skip>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    </properties>
    <dependencies>
        <!--suppress VulnerableLibrariesLocal -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
        </dependency>
        <dependency>
            <groupId>org.javassist</groupId>
            <artifactId>javassist</artifactId>
            <version>${javassist.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>${rocketmq.spring.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.javassist</groupId>
                    <artifactId>javassist</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.openapi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Xshare:off -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.maven.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google.java.format.version}</version>
                        </googleJavaFormat>
                        <importOrder/>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                    <formats>
                        <format>
                            <includes>
                                <include>*.md</include>
                                <include>*.xml</include>
                                <include>*.yml</include>
                                <include>*.yaml</include>
                                <include>.editorconfig</include>
                                <include>.gitignore</include>
                            </includes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven.pmd.plugin.version}</version>
                <configuration>
                    <includeTests>false</includeTests>
                    <linkXRef>false</linkXRef>
                    <analysisCache>true</analysisCache>
                    <targetJdk>${java.version}</targetJdk>
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <minimumTokens>80</minimumTokens>
                    <skipEmptyReport>true</skipEmptyReport>
                    <rulesets>
                        <ruleset>${project.basedir}/config/quality/pmd.xml</ruleset>
                    </rulesets>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cpd-check</goal>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.maven.plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <includeTests>false</includeTests>
                    <failOnError>true</failOnError>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.h3xstream.findsecbugs</groupId>
                        <artifactId>findsecbugs-plugin</artifactId>
                        <version>${findsecbugs.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>spotbugs</goal>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <configuration>
                            <destFile>${jacoco.data.file}</destFile>
                            <propertyName>argLine</propertyName>
                        </configuration>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <configuration>
                            <dataFile>${jacoco.data.file}</dataFile>
                            <outputDirectory>${jacoco.output.directory}</outputDirectory>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                                <format>CSV</format>
                            </formats>
                        </configuration>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${jacoco.data.file}</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>io.github.georgecodes.betsettler.domain.model</include>
                                        <include>io.github.georgecodes.betsettler.domain.validation</include>
                                        <include>io.github.georgecodes.betsettler.domain.service</include>
                                        <include>io.github.georgecodes.betsettler.application.dto</include>
                                           <include>io.github.georgecodes.betsettler.application.model.audit</include>
                                           <include>io.github.georgecodes.betsettler.application.model.dispatch</include>
                                        <include>io.github.georgecodes.betsettler.application.port.out</include>
                                        <include>io.github.georgecodes.betsettler.application.service</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.domain.application.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.domain.application.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>io.github.georgecodes.betsettler.infrastructure.config</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.observability</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.rest.controller</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.rest.dto</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.rest.error</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.rest.mapper</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.persistence.adapter</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.persistence.entity</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.persistence.mapper</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.messaging.kafka.consumer</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.messaging.kafka.dto</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.messaging.kafka.mapper</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.messaging.kafka.producer</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.messaging.settlement.dto</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.messaging.settlement.mapper</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.messaging.settlement.payload</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.messaging.settlement.publisher</include>
                                        <include>io.github.georgecodes.betsettler.infrastructure.messaging.rocketmq.publisher</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.infrastructure.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.infrastructure.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <doclint>all</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>javadoc-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>compact-constructor-javadoc-param-check</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <skip>${compact.constructor.javadoc.param.check.skip}</skip>
                            <executable>${java.home}${file.separator}bin${file.separator}java</executable>
                            <arguments>
                                <argument>${project.basedir}${file.separator}config${file.separator}quality${file.separator}CompactConstructorJavadocParamCheck.java</argument>
                                <argument>${project.basedir}${file.separator}src${file.separator}main${file.separator}java</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
